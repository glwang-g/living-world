[Unit]
Description=Living World web application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/living-world
Environment=NODE_ENV=production
Environment=WRANGLER_LOG_PATH=/home/ubuntu/living-world/.wrangler/wrangler.log
ExecStart=/usr/bin/env npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
